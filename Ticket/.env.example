# Copy to .env and replace every placeholder. Keep .env out of version control.
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
NGINX_BIND_ADDRESS=127.0.0.1
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

DB_NAME=railway_ticket
DB_USER=railway_app
DB_PASSWORD=replace-with-a-long-random-database-password
# These local defaults are overridden by Compose to pgbouncer:6432.
DB_HOST=localhost
DB_PORT=6432

# These local defaults are overridden by Compose to redis:6379.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/1

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=

SSL_COMMERZ_STORE_ID=
SSL_COMMERZ_STORE_PASSWORD=
SSL_COMMERZ_GATEWAY_URL=https://sandbox.sslcommerz.com/gwprocess/v4/api.php
SSL_COMMERZ_VALIDATION_URL=https://sandbox.sslcommerz.com/validator/api/validationserverAPI.php